{
  "name": "takeone",
  "version": "0.1.0",
  "description": "Scripted, agent-friendly screen recordings of web apps with Screen Studio style cursor, zoom and framing. Runs headless.",
  "type": "module",
  "license": "MIT",
  "author": "Atharva Deosthale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharvadeosthale/takeone.git"
  },
  "homepage": "https://github.com/atharvadeosthale/takeone#readme",
  "bugs": {
    "url": "https://github.com/atharvadeosthale/takeone/issues"
  },
  "keywords": [
    "screen-recording",
    "video",
    "playwright",
    "demo",
    "agent",
    "mcp",
    "screencast",
    "screen-studio"
  ],
  "bin": {
    "takeone": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2"
  }
}
